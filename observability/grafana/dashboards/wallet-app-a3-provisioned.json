{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "Wallet App - Load Balancing & Multi-Replica (Assignment 3)",
  "description": "Per-replica load distribution, traffic share, active requests, latency percentiles, and Envoy proxy observability.",
  "tags": [
    "wallet",
    "assignment-3",
    "load-balancing",
    "envoy"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Replica Load Balancing & Traffic Distribution",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "Request Rate per Replica (ops/sec)",
      "description": "Number of HTTP and gRPC requests handled per second by each backend replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (replica) (rate(http_requests_total[1m]))",
          "legendFormat": "HTTP Replica {{replica}}",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (replica) (rate(grpc_server_handled_total[1m]))",
          "legendFormat": "gRPC Replica {{replica}}",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Traffic Share (% of Total Traffic)",
      "description": "Percentage share of incoming traffic served by each replica (expected ~33% in round-robin, ~50%/25%/25% in weighted).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (replica) (rate(http_requests_total[1m])) / ignoring(replica) group_left sum(rate(http_requests_total[1m])) * 100",
          "legendFormat": "Replica {{replica}} Share %",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 3
    },
    {
      "type": "row",
      "title": "Active Concurrency & Latency Profile",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Active Concurrent Requests per Replica",
      "description": "Number of simultaneous requests actively being processed on each replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (replica) (http_requests_in_progress)",
          "legendFormat": "Replica {{replica}} Active In-Flight",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Latency p50 per Replica (Median)",
      "description": "Median response time in milliseconds per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "histogram_quantile(0.50, sum by (replica, le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000",
          "legendFormat": "Replica {{replica}} p50",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Latency p95 per Replica (Tail)",
      "description": "95th-percentile response time in milliseconds per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "histogram_quantile(0.95, sum by (replica, le) (rate(http_request_duration_seconds_bucket[1m]))) * 1000",
          "legendFormat": "Replica {{replica}} p95",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 7
    },
    {
      "type": "row",
      "title": "Status Breakdown & Envoy Reverse Proxy",
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "Errors & Responses by HTTP Status per Replica",
      "description": "Throughput breakdown by HTTP response status code per replica.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (replica, status_code) (rate(http_requests_total{status_code=~\"[245]..\"}[1m]))",
          "legendFormat": "Replica {{replica}} [{{status_code}}]",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Envoy Cluster Upstream Requests & Health",
      "description": "Envoy proxy L7 metrics: upstream request rate and healthy host counts per cluster.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-main"
      },
      "gridPos": {
        "x": 12,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (envoy_cluster_name) (rate(envoy_cluster_upstream_rq_total[1m]))",
          "legendFormat": "Cluster {{envoy_cluster_name}} Rate",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-main"
          },
          "expr": "sum by (envoy_cluster_name) (envoy_cluster_membership_healthy)",
          "legendFormat": "Cluster {{envoy_cluster_name}} Healthy Hosts",
          "refId": "B",
          "instant": false,
          "range": true
        }
      ],
      "id": 10
    }
  ],
  "uid": "wallet-app-a3"
}
